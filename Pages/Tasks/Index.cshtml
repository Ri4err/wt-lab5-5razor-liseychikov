@page
@model wt_lab5_5razor_liseychikov.Pages.Tasks.IndexModel
@{
    ViewData["Title"] = "Каталог задач";
}

<div class="container mt-4">
    <h1 class="mb-4">Каталог задач проекта</h1>

    <div class="row">
        @foreach (var task in Model.Tasks)
        {
            <div class="col-12 col-md-6 col-lg-4 mb-4">
                <div class="card shadow rounded h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary">#@task.Id</span>
                            <span class="badge bg-secondary">@task.Category</span>
                        </div>
                        
                        <h5 class="card-title">@task.Name</h5>
                        
                        <p class="card-text text-muted mb-4">
                            Стоимость: <strong>@task.Price руб.</strong>
                        </p>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            @if (task.IsAvaliable)
                            {
                                <span class="badge bg-success">Доступна</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Недоступна</span>
                            }
                            
                            <a href="#" class="btn btn-outline-primary btn-sm">Подробнее</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>