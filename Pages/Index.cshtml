@page
@model IndexModel
@{
    ViewData["Title"] = "Главная страница";
}

<div class="container py-5">
    <div class="row justify-content center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm rounded-4 border-0 p-4 text-center">
                <div class="card-body">
                    <h1 class="fw-bold mb-3">Управление IT-проектами</h1>
                    <p class="text-muted mb-4">
                        Добро пожаловать к нам! Мы занимаемся всем, что касается ваших проектов. Нам подвласны
                        любые задачи: от создания сервиса до проверки, контроля и составления плана
                    </p>
                    <a href="/Tasks" class="btn btn-primary btn-lg rounded-pill px-4">
                        Перейти к задачам проекта
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
